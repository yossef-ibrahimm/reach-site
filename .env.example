# ---------------------------------------------------------------------------
# Eltawkol Fire — environment template.
#
# Copy to `.env` for local development:  cp .env.example .env
# `.env` is git-ignored and must never be committed.
#
# SECURITY NOTES
#  * The `anon` / `publishable` key is PUBLIC BY DESIGN. It ships in the browser
#    bundle. It is only safe because every write in Postgres is guarded by Row
#    Level Security (see supabase/schema.sql).
#  * NEVER put the `service_role` / `sb_secret_` key here or in any `VITE_*`
#    variable. VITE_* values are inlined into client JavaScript at build time.
#    `scripts/import-json.mjs` reads the service key from a local shell
#    environment variable instead:  SUPABASE_SERVICE_ROLE_KEY=... node scripts/import-json.mjs
# ---------------------------------------------------------------------------

# Project URL shown in Supabase -> Project Settings -> API
VITE_SUPABASE_URL=

# Public/anon (or new-style `sb_publishable_...`) key
VITE_SUPABASE_PUBLISHABLE_KEY=

# Alias used by the generated server-side client (read by Node, not the browser)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used by scripts/import-json.mjs when exported into the shell.
# NEVER add a VITE_ prefix to this and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
